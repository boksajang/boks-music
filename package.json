{
  "name": "boks-music",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "Project-based local AI music creation",
  "author": "boksajang",
  "license": "MIT",
  "type": "module",
  "main": "electron/entry.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/icons.mjs",
    "package": "npm run build && npm run icons && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "music-metadata": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "playwright": "latest",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "8.3.2"
  },
  "build": {
    "appId": "com.boksajang.boksmusic",
    "productName": "Boks Music",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.d.mts",
      "assets/icon.ico",
      "assets/icon.png",
      "video-templates/**/*.json",
      "package.json",
      "!**/*.map",
      "!**/*.md"
    ],
    "extraResources": [
      {
        "from": "engines",
        "to": "engines",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!test_*.py",
          "!native_dll_probe.py",
          "!*.md"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "compression": "maximum",
    "afterPack": "scripts/after-pack.cjs",
    "publish": null
  }
}
